{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug in browser (server already running)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run production build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build; npm start",
      "cwd": "${workspaceFolder}"
    }
  ]
}
